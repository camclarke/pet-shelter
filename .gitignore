# terraform
# .terraform.lock.hcl is intentionally NOT ignored — committing it pins
# provider versions across the team and across the eventual tenant move.
terraform/**/.terraform/
terraform/**/*.tfstate
terraform/**/*.tfstate.*
terraform/**/*.tfvars
!terraform/**/*.tfvars.example
terraform/**/backend.hcl
!terraform/**/backend.hcl.example
terraform/**/crash.log

# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/
# The maintainer's local project log.
CLAUDE.md

# seed data
# Real pet files and their photos are the shelter's own content, not the
# template's — and a photo straight off a phone carries EXIF the seeder
# strips on UPLOAD, which is too late if the original is already committed.
# Only the filled-in-by-you template is tracked.
seed/*
!seed/EXAMPLE-pet.json

# Local-only E2E photo drop (real animal photos, never committed).
# Same rule and same reason as seed/ above: a photo straight off a phone
# carries EXIF, and one taken in a foster home carries a volunteer's home
# address. Only the answer-key TEMPLATE is tracked — a filled-in
# ground-truth.json describes a real animal and stays local with its photos.
_e2e/*
!_e2e/EXAMPLE-ground-truth.json
# Synthetic vaccination cards for `npm run eval:cards`. Generated, so only the
# answer-key TEMPLATE is tracked; the images and the filled-in key are rebuilt
# by `npm run cards:synthesize`. A REAL card photographed for the eval carries
# an owner's name, address and phone, and must never be committed.
!_e2e/cards/
_e2e/cards/*
!_e2e/cards/EXAMPLE-ground-truth.json
