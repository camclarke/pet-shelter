rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// pet-shelter — Cloud Storage security rules
//
// Storage is the one place where an unbounded upload turns directly into a
// bill, so every writable path caps size and content type.
// ═══════════════════════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {

    // ── roles ──────────────────────────────────────────────────────────────
    // The same claims and the same meaning as firestore.rules: one boolean
    // per role, set only by scripts/grant-role.mjs; the table is
    // src/config/roles.ts. `get(r, false)`: a missing claim reads false.
    function hasRole(role) {
      return request.auth != null && request.auth.token.get(role, false) == true;
    }

    function isSuper() {
      return hasRole('su');
    }

    function isShelterOwner() {
      return hasRole('owner');
    }

    function isRescuer() {
      return hasRole('rescuer');
    }

    // COORDINATION OR HIGHER — the name is kept from before roles existed,
    // when it meant `token.admin == true`. See firestore.rules.
    function isAdmin() {
      return request.auth != null && (hasRole('admin') || isSuper() || isShelterOwner());
    }

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|avif)');
    }

    // ── Rescatista on pet photos (plan §3) ─────────────────────────────────
    // A rescuer photographs the animals they add, so they may CREATE a photo —
    // never overwrite one (no `update`) — stamped with their own uid in the
    // object's custom metadata. They may delete only their OWN upload, and only
    // within 24 hours: long enough to fix a bad shot during an intake, short
    // enough that a photo already on a published animal is not theirs to pull.
    //
    // No Firestore read: the draft's `createdBy` cannot be checked from here
    // without a cross-service call and a new IAM grant. Accepted residue
    // (plan §5): a rescuer could add an unreferenced image to any pet's
    // folder. It stays image-only and size-capped, overwrites nothing, and
    // nothing links to it.
    function rescuerUploadsOwn() {
      return isRescuer()
        && isImage()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.metadata.uploadedBy == request.auth.uid;
    }

    function rescuerDeletesOwnRecent() {
      return isRescuer()
        && resource.metadata.uploadedBy == request.auth.uid
        && resource.timeCreated > request.time - duration.value(24, 'h');
    }

    // ── pet photos ─────────────────────────────────────────────────────────
    // Readable by anyone: the cover image appears on the public wall, and
    // gating images behind auth would mean proxying them through a function.
    // Access control for *which* photos a visitor learns about lives in
    // Firestore — an unguessable URL is not a secret, but the gallery list is.
    // ⚠️ `create, update` and `delete` are SEPARATE on purpose. `allow write`
    // covers all three, and on a delete `request.resource` is null — so
    // `isImage()` dereferences null, the rule errors, and the delete is
    // denied. That is not a hypothetical: this rule shipped as a single
    // `allow write` on 2026-08-02 and an admin could upload a pet photo but
    // never remove one. Nothing noticed until the intake wizard's "Quitar"
    // button became the first code in the project to attempt a delete.
    //
    // The size and content-type checks belong only on the paths that carry a
    // payload. Deleting needs to prove who you are, nothing more.
    match /pets/{petId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && isImage() && request.resource.size < 8 * 1024 * 1024;
      allow delete: if isAdmin();
      allow create: if rescuerUploadsOwn();
      allow delete: if rescuerDeletesOwnRecent();
    }

    // ── intimate + clinical pet photos ─────────────────────────────────────
    // The teeth and genital shots exist to read age and sex. Neither belongs on
    // an adoption listing, and the capture UI promises "esta foto nunca se
    // publica" — a promise that lived only in Firestore until 2026-09-03, when
    // a real object was measured returning 200 to an unauthenticated fetch,
    // both with a download token and without one.
    //
    // ⚠️ This rule is only HALF the fix. A Firebase DOWNLOAD TOKEN bypasses
    // storage.rules entirely — measured against an admin-only `medical/**`
    // object: 200 with `?token=`, 403 without, same object, same rule. So the
    // upload path must ALSO refrain from calling getDownloadURL() on these,
    // because that call returns a token and no rule can revoke one.
    // See uploadProcessedPhoto() in src/lib/pets-admin.ts.
    //
    // ⚠️ KNOWN RESIDUAL, and 2026-09-10 measured how much it matters.
    // Firebase's UPLOAD endpoint auto-mints a firebaseStorageDownloadTokens
    // value by itself, so not calling getDownloadURL does NOT stop a token
    // EXISTING, and a token bypasses these rules. On a private object:
    // 403 without it, 200 WITH it.
    //
    // But the token lives in object METADATA, and the metadata endpoint is
    // gated by this same rule. Measured anonymously on the private prefix:
    //
    //     metadata (no ?alt=media) : 403   <- the token is NOT obtainable
    //     bytes    (?alt=media)    : 403
    //     bytes    with the token  : 200
    //
    // So the token is reachable only by someone who already has read access,
    // and such a caller can fetch the bytes directly. IT WIDENS NOTHING. The
    // residual is defence in depth, not an open hole: an unrevocable key that
    // would matter if it ever escaped by some OTHER route — a log, a backup,
    // an export, or a future code path that reads metadata and surfaces it.
    //
    // Closing it means stripping the token after upload, and that is still
    // gated on a client-SDK probe, because a metadata-only write is evaluated
    // against `create, update` below and request.resource semantics there are
    // the null-dereference class that made `allow write` deny every delete for
    // three weeks. Given it widens nothing, that trade still favours leaving
    // the upload path alone.
    //
    // Read is `request.auth != null` rather than isAdmin() so the bucket
    // enforces exactly the tier the media document declares — mediaTierFor()
    // returns 'auth' for these slots. Tightening only one of the two would put
    // them back out of step, which is the defect this rule exists to close.
    match /pets/{petId}/private/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin() && isImage() && request.resource.size < 8 * 1024 * 1024;
      allow delete: if isAdmin();
      allow create: if rescuerUploadsOwn();
      allow delete: if rescuerDeletesOwnRecent();
    }

    // ── sighting photos ────────────────────────────────────────────────────
    // Uploaded by anonymous reporters, so tighter: smaller cap, and App Check
    // is enforced at the bucket level. Sightings are moderated in Firestore
    // before an image is ever surfaced.
    match /sightings/{sightingId}/{fileName} {
      allow read: if true;
      allow create: if isImage() && request.resource.size < 4 * 1024 * 1024;
      allow update, delete: if isAdmin();
    }

    // ── profile photos ─────────────────────────────────────────────────────
    // A person's own photo, uploaded from /account after the same EXIF strip
    // as every pet photo (src/lib/image-strip.ts) — a photo taken at home
    // carries the home's GPS.
    //
    // Only the owner writes; the owner and admins read. The upload path does
    // call getDownloadURL(), whose token bypasses these rules for anyone
    // holding the URL — accepted for a profile photo only, see uploadAvatar()
    // in src/lib/auth.ts.
    //
    // No `update`: every upload gets a fresh name, so a replaced photo is a
    // new object plus a delete, never an overwrite a cached URL keeps showing.
    // The name pattern mirrors AVATAR_FILE_NAME in src/lib/profile.ts.
    // Deleting the account removes the whole users/{uid}/ prefix through the
    // Admin SDK, which bypasses these rules.
    match /users/{uid}/avatar/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null
        && request.auth.uid == uid
        && fileName.matches('^[A-Za-z0-9-]{1,64}[.]jpg$')
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size < 2 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ── medical documents: vaccination cards, lab results ──────────────────
    // Never public, and never in the merely-authenticated tier either. These
    // scans carry a veterinarian's details and, very often, the owner's name,
    // address, and phone number printed on the card. Admins only; the Stage 2
    // LLM parser reads them through the Admin SDK, which bypasses these rules.
    match /medical/{petId}/{fileName} {
      allow read, write: if isAdmin();
    }

    // ── adoption ID documents ──────────────────────────────────────────────
    // A photo of an applicant's identity card: the most sensitive object this
    // bucket holds. Path: adoption-ids/{petId}__{uid}/{side}.jpg, built only in
    // src/lib/id-document-paths.ts.
    //   - NO browser writes it, ever. POST /api/adoption-applications/{id}/
    //     id-document/{side} saves it through the Admin SDK, which bypasses
    //     these rules and does not go through Firebase's upload endpoint — the
    //     one that auto-mints a download token (see the private-photo block).
    //     So create, update AND delete are all denied here; erasure is the
    //     Admin SDK's (the retention sweep, an admin's erase request).
    //   - Admins read it, through getBlob(), loaded only on tap. NEVER
    //     getDownloadURL(): that mints a token no rule can revoke. A test walks
    //     the imports of every file that builds an adoption-ids path.
    //   - NOT the applicant: they hold the original card, and a stolen session
    //     must not yield a copy of it (owner decision, 2026-10-16).
    //   - NOT under users/{uid}/: account deletion wipes that whole prefix,
    //     while the application this photo supports is kept (/privacy).
    //   - NOT under pets/*/private: any signed-in user can read that.
    // scripts/test-storage-application-rules.mjs checks both branches.
    match /adoption-ids/{applicationId}/{fileName} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
