rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// pet-shelter — Firestore security rules
//
// These rules ARE the authorization layer. Clients read Firestore directly;
// no Cloud Function sits in front of reads, because rules evaluation is free
// and a function invocation is not. Everything below is therefore load-bearing.
//
// Three principles:
//   1. Visibility tiers are documents, not fields. Rules cannot protect a field.
//   2. Admin is a custom auth claim, never a Firestore field. Reading a field
//      inside a rule costs a document read on every evaluation.
//   3. A microchip number and a scan trail are identifying data about the
//      HUMAN as much as the animal. They sit in the restricted tier, not the
//      merely-authenticated one.
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ────────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // Does the signed-in user own this pet? One document read, and only on the
    // restricted paths where it is unavoidable. `adoptions` is keyed by petId
    // precisely so this resolves in a single get().
    function ownsPet(petId) {
      return signedIn()
        && exists(/databases/$(database)/documents/adoptions/$(petId))
        && get(/databases/$(database)/documents/adoptions/$(petId)).data.ownerUid == request.auth.uid;
    }

    function adminOrOwner(petId) {
      return isAdmin() || ownsPet(petId);
    }

    // Clamp coordinates to the service area. Keeps a spammer from scattering
    // fake sightings across the planet. Mirrors SHELTER.bounds in
    // src/config/shelter.ts — update both together; this copy is the one that
    // is actually enforced.
    function withinServiceArea(geo) {
      return geo.latitude  >= -17.75 && geo.latitude  <= -17.15
          && geo.longitude >= -66.45 && geo.longitude <= -65.85;
    }

    // ── pets/{petId} ───────────────────────────────────────────────────────
    // Public teaser. Indexable and shareable: this is how an adopter finds the
    // pet in the first place. Carries `hasMicrochip` as a boolean but never
    // the number itself.
    match /pets/{petId} {
      allow read: if true;
      allow write: if isAdmin();

      // ── detail — everything of substance, behind a login ─────────────────
      match /detail/{docId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }

      // ── identity — the microchip number ──────────────────────────────────
      // Deliberately NOT in the authenticated tier. The chip number is the
      // credential by which ownership gets asserted to registries and vets;
      // anyone who can read it can claim the animal is theirs. Creating an
      // account is not a reason to learn every chipped animal's number.
      //
      // Lookup in the other direction — "I scanned a chip, whose pet is
      // this?" — deliberately does not happen here. That runs server-side
      // (findPetByMicrochip) and returns only the public record, so a finder
      // gets a name and a way to make contact without the ability to
      // enumerate the registry.
      match /identity/{docId} {
        allow read: if adminOrOwner(petId);
        allow write: if isAdmin();
      }

      // ── location — the sharpest edge in the whole schema ─────────────────
      // For a fostered pet this is a volunteer's home address. For an adopted
      // pet it is the adopter's. Admins and the current owner, nobody else.
      match /location/{docId} {
        allow read: if adminOrOwner(petId);
        allow write: if isAdmin();
      }

      // ── scans — the last-known-location ledger ───────────────────────────
      // Restricted for the same reason as `location`, and arguably more so: a
      // single location is one address, whereas a scan history is a pattern of
      // movement over time. For an adopted pet that is a trail of its owner's
      // vet, neighbourhood, and routine.
      //
      // Writes are admin-only: a scan record asserts "this animal was here",
      // and an unauthenticated public that could forge those could plant false
      // recovery trails. Members of the public report through `sightings`,
      // which is moderated.
      match /scans/{scanId} {
        allow read: if adminOrOwner(petId);
        allow write: if isAdmin();
      }

      // ── custody — the chain of responsibility ────────────────────────────
      match /custody/{custodyId} {
        allow read: if adminOrOwner(petId);
        allow write: if isAdmin();
      }

      // ── medical history ──────────────────────────────────────────────────
      // Gated, not public: publishing "FIV positive" or "reactive to men"
      // openly harms the animal's chances more than it helps. An adopter who
      // has signed in gets the full picture before committing.
      match /medical/{recordId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }

      // ── care: feeding plan ───────────────────────────────────────────────
      // Travels with the animal so an adopter can avoid an abrupt diet change.
      match /care/{docId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }

      // ── media — photos and video ─────────────────────────────────────────
      // THE ONE PLACE a tier is a field rather than a document, and the only
      // rule here that reads `resource.data`. Media is many-per-pet and
      // unbounded: an array inside one document would be rewritten on every
      // upload and would approach the 1 MiB ceiling on a pet with 40 photos
      // plus video derivatives.
      //
      // ⚠️ On a QUERY this is evaluated against the query's CONSTRAINTS, not
      // its results. An unauthenticated client must issue
      // `where('tier','==','public')` or the entire query is rejected —
      // Firestore does not return a filtered subset. It will look like a
      // broken query rather than a permission decision.
      match /media/{mediaId} {
        allow read: if resource.data.tier == 'public' || signedIn();
        allow write: if isAdmin();
      }

      // ── measurements — weight and body condition ─────────────────────────
      // Authenticated rather than public: an adopter deciding on an animal
      // should see it, a casual browser has no need. Admin-write because a
      // weight feeds mg/kg dosing, and a number that a drug dose is computed
      // against is not something an unverified account may set.
      match /measurements/{measurementId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }

      // ── placements — the outbreak ledger ─────────────────────────────────
      // Where the animal has been INSIDE THIS FACILITY, as intervals. Note
      // what this is not: a foster home is never an area, so a volunteer's
      // home address cannot reach this collection by any path. That is why it
      // can sit in the authenticated tier while `location` cannot.
      match /placements/{placementId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }

      // ── sightings — public read AND public create, by design ─────────────
      // Someone who spots a lost pet must be able to report it in seconds,
      // with no account. That openness is the feature, so every constraint
      // below is doing real work. App Check is enforced separately and is
      // what stops writes from outside our own origin.
      match /sightings/{sightingId} {
        allow read: if true;

        allow create: if
          // exact field whitelist — nothing unexpected gets stored
          request.resource.data.keys().hasOnly([
            'geo', 'note', 'photoUrl', 'contact', 'reportedAt', 'status', 'reviewedBy'
          ])
          && request.resource.data.keys().hasAll(['geo', 'note', 'reportedAt', 'status'])

          && request.resource.data.geo is latlng
          && withinServiceArea(request.resource.data.geo)

          && request.resource.data.note is string
          && request.resource.data.note.size() > 0
          && request.resource.data.note.size() <= 500

          && (!('contact' in request.resource.data.keys())
              || request.resource.data.contact == null
              || (request.resource.data.contact is string
                  && request.resource.data.contact.size() <= 40))

          && (!('photoUrl' in request.resource.data.keys())
              || request.resource.data.photoUrl == null
              || (request.resource.data.photoUrl is string
                  && request.resource.data.photoUrl.size() <= 500))

          // an anonymous reporter cannot self-confirm a sighting
          && request.resource.data.status == 'pending'
          && request.resource.data.reviewedBy == null

          // no backdating or postdating
          && request.resource.data.reportedAt == request.time;

        // Triage is an admin job. Reports are immutable to their reporter —
        // there is no identity to authenticate an edit against.
        allow update, delete: if isAdmin();
      }
    }

    // ── collection-group reads ─────────────────────────────────────────────
    // A collectionGroup query is evaluated against these rules, not the
    // nested ones above, so each group that gets queried needs an explicit
    // decision. `identity` is queried by microchip code on the server via the
    // Admin SDK (which bypasses rules entirely); from a client it stays shut.
    match /{path=**}/identity/{docId} {
      allow read: if isAdmin();
    }

    match /{path=**}/scans/{scanId} {
      allow read: if isAdmin();
    }

    // The admin moderation queue spans every pet's sightings.
    match /{path=**}/sightings/{sightingId} {
      allow read: if true;
    }

    // The outbreak trace and the area occupancy count both run
    // collectionGroup('placements') filtered by areaId. Admin-only: this is
    // operational data about the whole facility, and a signed-in adopter has
    // no business enumerating every animal's movements. Deliberately narrower
    // than the per-pet rule above, which an adopter legitimately reads for
    // their own animal.
    match /{path=**}/placements/{placementId} {
      allow read: if isAdmin();
    }

    // ── users/{uid} ────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);

      // A user may create and maintain their own profile, but may not invent
      // privileges. Admin lives in a custom claim set server-side; should a
      // stray `role` field ever appear here, it must never be self-assigned.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['uid', 'email', 'displayName', 'photoURL', 'createdAt'])
        && request.resource.data.uid == uid;

      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'photoURL']);

      allow delete: if isAdmin();
    }

    // ── adoptions/{petId} ──────────────────────────────────────────────────
    // Keyed by petId so ownsPet() resolves in a single get(). Establishes who
    // may read a pet's microchip, location, and scan history — so only an
    // admin may write it.
    match /adoptions/{petId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if isAdmin();
    }

    // ── areas/{areaId} ─────────────────────────────────────────────────────
    // The shelter's own pens and yards. Admin-only in BOTH directions, which
    // is stricter than it first looks: an area list plus a placement ledger
    // is a map of the facility, and the layout of a building that houses
    // volunteers and animals is not public information. Nothing on the public
    // site needs it — the wall shows animals, never where they sleep.
    match /areas/{areaId} {
      allow read, write: if isAdmin();
    }

    // ── default deny ───────────────────────────────────────────────────────
    // Anything not matched above is inaccessible. New collections must opt in
    // deliberately rather than inherit access by accident.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
