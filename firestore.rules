rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// pet-shelter — Firestore security rules
//
// These rules ARE the authorization layer. Clients read Firestore directly;
// no Cloud Function sits in front of reads, because rules evaluation is free
// and a function invocation is not. Everything below is therefore load-bearing.
//
// Three principles:
//   1. Visibility tiers are documents, not fields. Rules cannot protect a field.
//   2. Admin is a custom auth claim, never a Firestore field. Reading a field
//      inside a rule costs a document read on every evaluation.
//   3. A microchip number and a scan trail are identifying data about the
//      HUMAN as much as the animal. They sit in the restricted tier, not the
//      merely-authenticated one.
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ────────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // Does the signed-in user own this pet? One document read, and only on the
    // restricted paths where it is unavoidable. `adoptions` is keyed by petId
    // precisely so this resolves in a single get().
    function ownsPet(petId) {
      return signedIn()
        && exists(/databases/$(database)/documents/adoptions/$(petId))
        && get(/databases/$(database)/documents/adoptions/$(petId)).data.ownerUid == request.auth.uid;
    }

    function adminOrOwner(petId) {
      return isAdmin() || ownsPet(petId);
    }

    // Clamp coordinates to the service area. Keeps a spammer from scattering
    // fake sightings across the planet. Mirrors SHELTER.bounds in
    // src/config/shelter.ts — update both together; this copy is the one that
    // is actually enforced.
    function withinServiceArea(geo) {
      return geo.latitude  >= -17.75 && geo.latitude  <= -17.15
          && geo.longitude >= -66.45 && geo.longitude <= -65.85;
    }

    // ── pets/{petId} ───────────────────────────────────────────────────────
    // Public teaser. Indexable and shareable: this is how an adopter finds the
    // pet in the first place. Carries `hasMicrochip` as a boolean but never
    // the number itself.
    match /pets/{petId} {
      allow read: if true;
      allow write: if isAdmin();

      // ── detail — everything of substance, behind a login ─────────────────
      match /detail/{docId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }

      // ── identity — the microchip number ──────────────────────────────────
      // Deliberately NOT in the authenticated tier. The chip number is the
      // credential by which ownership gets asserted to registries and vets;
      // anyone who can read it can claim the animal is theirs. Creating an
      // account is not a reason to learn every chipped animal's number.
      //
      // Lookup in the other direction — "I scanned a chip, whose pet is
      // this?" — deliberately does not happen here. That runs server-side
      // (findPetByMicrochip) and returns only the public record, so a finder
      // gets a name and a way to make contact without the ability to
      // enumerate the registry.
      match /identity/{docId} {
        allow read: if adminOrOwner(petId);
        allow write: if isAdmin();
      }

      // ── location — the sharpest edge in the whole schema ─────────────────
      // For a fostered pet this is a volunteer's home address. For an adopted
      // pet it is the adopter's. Admins and the current owner, nobody else.
      match /location/{docId} {
        allow read: if adminOrOwner(petId);
        allow write: if isAdmin();
      }

      // ── scans — the last-known-location ledger ───────────────────────────
      // Restricted for the same reason as `location`, and arguably more so: a
      // single location is one address, whereas a scan history is a pattern of
      // movement over time. For an adopted pet that is a trail of its owner's
      // vet, neighbourhood, and routine.
      //
      // Writes are admin-only: a scan record asserts "this animal was here",
      // and an unauthenticated public that could forge those could plant false
      // recovery trails. Members of the public report through `sightings`,
      // which is moderated.
      match /scans/{scanId} {
        allow read: if adminOrOwner(petId);
        allow write: if isAdmin();
      }

      // ── custody — the chain of responsibility ────────────────────────────
      match /custody/{custodyId} {
        allow read: if adminOrOwner(petId);
        allow write: if isAdmin();
      }

      // ── medical history ──────────────────────────────────────────────────
      // Gated, not public: publishing "FIV positive" or "reactive to men"
      // openly harms the animal's chances more than it helps. An adopter who
      // has signed in gets the full picture before committing.
      match /medical/{recordId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }

      // ── medical CANDIDATES — what a model read and nobody has confirmed ──
      // Admins only, for every verb. Read, create, update and delete each
      // require the admin claim and nothing else; no condition reads
      // `request.resource`, so a delete cannot trip over a null payload.
      //
      // A NEW TIER, so a NEW DOCUMENT. `medical` above is readable by any
      // signed-in account, and an unchecked model guess does not belong at
      // that tier (step-9 evaluation, 2026-09-13). A candidate becomes a
      // `medical` record only when an admin confirms it, which creates the
      // record and deletes the candidate in one transaction.
      //
      // Written by `/api/medical/cards/extract` through the Admin SDK, which
      // bypasses these rules; read, confirmed and discarded by an admin's
      // browser, which is what this rule governs.
      match /medicalCandidates/{candidateId} {
        allow read, create, update, delete: if isAdmin();
      }

      // ── care: feeding plan ───────────────────────────────────────────────
      // Travels with the animal so an adopter can avoid an abrupt diet change.
      match /care/{docId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }

      // ── media — photos and video ─────────────────────────────────────────
      // THE ONE PLACE a tier is a field rather than a document, and the only
      // rule here that reads `resource.data`. Media is many-per-pet and
      // unbounded: an array inside one document would be rewritten on every
      // upload and would approach the 1 MiB ceiling on a pet with 40 photos
      // plus video derivatives.
      //
      // ⚠️ On a QUERY this is evaluated against the query's CONSTRAINTS, not
      // its results. An unauthenticated client must issue
      // `where('tier','==','public')` or the entire query is rejected —
      // Firestore does not return a filtered subset. It will look like a
      // broken query rather than a permission decision.
      match /media/{mediaId} {
        allow read: if resource.data.tier == 'public' || signedIn();
        allow write: if isAdmin();
      }

      // ── measurements — weight and body condition ─────────────────────────
      // Authenticated rather than public: an adopter deciding on an animal
      // should see it, a casual browser has no need. Admin-write because a
      // weight feeds mg/kg dosing, and a number that a drug dose is computed
      // against is not something an unverified account may set.
      match /measurements/{measurementId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }

      // ── placements — the outbreak ledger ─────────────────────────────────
      // Where the animal has been INSIDE THIS FACILITY, as intervals. Note
      // what this is not: a foster home is never an area, so a volunteer's
      // home address cannot reach this collection by any path. That is why it
      // can sit in the authenticated tier while `location` cannot.
      match /placements/{placementId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }

      // ── sightings — public read AND public create, by design ─────────────
      // Someone who spots a lost pet must be able to report it in seconds,
      // with no account. That openness is the feature, so every constraint
      // below is doing real work. App Check is enforced separately and is
      // what stops writes from outside our own origin.
      match /sightings/{sightingId} {
        allow read: if true;

        allow create: if
          // exact field whitelist — nothing unexpected gets stored
          request.resource.data.keys().hasOnly([
            'geo', 'note', 'photoUrl', 'contact', 'reportedAt', 'status', 'reviewedBy'
          ])
          && request.resource.data.keys().hasAll(['geo', 'note', 'reportedAt', 'status'])

          && request.resource.data.geo is latlng
          && withinServiceArea(request.resource.data.geo)

          && request.resource.data.note is string
          && request.resource.data.note.size() > 0
          && request.resource.data.note.size() <= 500

          && (!('contact' in request.resource.data.keys())
              || request.resource.data.contact == null
              || (request.resource.data.contact is string
                  && request.resource.data.contact.size() <= 40))

          && (!('photoUrl' in request.resource.data.keys())
              || request.resource.data.photoUrl == null
              || (request.resource.data.photoUrl is string
                  && request.resource.data.photoUrl.size() <= 500))

          // an anonymous reporter cannot self-confirm a sighting
          && request.resource.data.status == 'pending'
          && request.resource.data.reviewedBy == null

          // no backdating or postdating
          && request.resource.data.reportedAt == request.time;

        // Triage is an admin job. Reports are immutable to their reporter —
        // there is no identity to authenticate an edit against.
        allow update, delete: if isAdmin();
      }
    }

    // ── collection-group reads ─────────────────────────────────────────────
    // A collectionGroup query is evaluated against these rules, not the
    // nested ones above, so each group that gets queried needs an explicit
    // decision. `identity` is queried by microchip code from TWO places, and
    // the distinction is the reason this rule is `isAdmin()` and not `false`:
    //
    //   - findPetByMicrochip()      the FINDER's path. Server-side, Admin SDK,
    //                               bypasses rules entirely, returns the public
    //                               tier only so a stranger who scans a stray
    //                               cannot enumerate the registry.
    //   - findPetByMicrochipAdmin() the SHELTER's path. Runs in the browser at
    //                               intake to deduplicate a re-admission, so it
    //                               is governed by this line and by nothing
    //                               else.
    //
    // A signed-in adopter still cannot run it. (An earlier version of this
    // comment said "from a client it stays shut", which was never what the
    // rule did — only what the code happened to do at the time.)
    match /{path=**}/identity/{docId} {
      allow read: if isAdmin();
    }

    match /{path=**}/scans/{scanId} {
      allow read: if isAdmin();
    }

    // The admin moderation queue spans every pet's sightings.
    match /{path=**}/sightings/{sightingId} {
      allow read: if true;
    }

    // The outbreak trace and the area occupancy count both run
    // collectionGroup('placements') filtered by areaId. Admin-only: this is
    // operational data about the whole facility, and a signed-in adopter has
    // no business enumerating every animal's movements. Deliberately narrower
    // than the per-pet rule above, which an adopter legitimately reads for
    // their own animal.
    match /{path=**}/placements/{placementId} {
      allow read: if isAdmin();
    }

    // ── users/{uid} ────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);

      // A user may create and maintain their own profile, but may not invent
      // privileges. Admin lives in a custom claim set server-side; should a
      // stray `role` field ever appear here, it must never be self-assigned.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['uid', 'email', 'displayName', 'photoURL', 'createdAt'])
        && request.resource.data.uid == uid;

      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'photoURL']);

      allow delete: if isAdmin();
    }

    // ── adoptions/{petId} ──────────────────────────────────────────────────
    // Keyed by petId so ownsPet() resolves in a single get(). Establishes who
    // may read a pet's microchip, location, and scan history — so only an
    // admin may write it.
    //
    // Its first writer is the approval batch in the admin application queue
    // (build-order step 14). What this rule permits is still exactly "an admin
    // writes, the named owner reads": an applicant can never create one naming
    // themselves, however their application is doing.
    //
    // ⚠️ Two consequences of ownsPet() to know before approving an adoption:
    //   - it unlocks EVERYTHING already in the restricted tiers, not only what
    //     is written from now on — a `location/current` recorded while the
    //     animal was fostered, and the names of earlier custody holders;
    //   - it is DELETED when an adopted animal is returned: reopenPet() removes
    //     it in the re-admission batch (readmissionRevokesOwnership), so the
    //     former family stops passing ownsPet(). `allow write` covers that
    //     delete; the ended ownership stays on record in the closed custody
    //     interval and the approved application.
    match /adoptions/{petId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if isAdmin();
    }

    // ── adoptionApplications/{applicationId} ───────────────────────────────
    // The optional online adoption application — plan §2.4 and §6. It holds a
    // private person's housing, household and phone number, so it is readable
    // by that person and by admins and by nobody else.
    //
    // What these rules permit, precisely:
    //   - while applicationsEnabled() returns true — and only then — an
    //     applicant CREATES only their own application, with the id
    //     `{petId}__{their uid}`, for a pet whose status is `available`, with
    //     status `submitted`, their token's email, answers inside the bounds
    //     below, and every decision field null;
    //   - an applicant GETS any id ending in their own uid — including one that
    //     does not exist yet, which is how the form learns whether they already
    //     applied — and LISTS only with a query constrained to their own uid;
    //   - an applicant UPDATES only to withdraw an open application, changing
    //     exactly `status`, `withdrawnAt` and `updatedAt`;
    //   - an admin reads everything and moves the status along
    //     applicationTransitions() without touching what the applicant wrote.
    //     Approving is refused unless the SAME batch writes adoptions/{petId}
    //     for this applicant and sets the pet to `adopted`;
    //   - nobody deletes. An application is a record of what someone said.
    //
    // ⚠️ The DOCUMENT ID is the duplicate guard. Rules cannot run a query, so
    // "one application per person per animal" is enforced by requiring the id
    // `{petId}__{uid}`: a second submission addresses the same document, is
    // evaluated as an UPDATE, and fails the withdraw-only branch.
    //
    // ⚠️ On a LIST these rules are evaluated against the query's CONSTRAINTS,
    // not its results. An applicant's query must carry
    // where('applicantUid', '==', uid) or it is rejected whole — the same trap
    // as `media` above.
    match /adoptionApplications/{applicationId} {

      // The question ids in src/config/shelter.ts, `adoptionApplications`.
      // THIS is the enforcing copy: an answer under any other key is refused.
      // Replacing the draft questions means changing this list AND deploying
      // the rules. A test fails if the two lists drift.
      function applicationAnswerKeys() {
        return ['fullName', 'whatsapp', 'zone', 'housingType', 'housingTenure',
                'landlordAllows', 'outdoorSpace', 'adults', 'children',
                'everyoneAgrees', 'otherPets', 'previousPets', 'hoursAlone',
                'whyThisAnimal'];
      }

      function applicationKeys() {
        return ['petId', 'applicantUid', 'applicantEmail', 'applicantEmailVerified',
                'answers', 'status', 'submittedAt', 'updatedAt', 'withdrawnAt',
                'decidedAt', 'decidedBy'];
      }

      // The bound on ANY answer. The rules cannot see a question's kind — that
      // lives in shelter config — so this is the worst case, and the form's
      // per-kind limits are stricter. Mirrors RULES_ANSWER_MAX_CHARS and
      // RULES_ANSWER_MAX_COUNT in src/lib/applications.ts.
      function validAnswer(v) {
        return v is bool
          || (v is int && v >= 0 && v <= 99)
          || (v is string && v.size() <= 1500);
      }

      // An unanswered question is ABSENT, and arrives here as the default
      // `true` from get(key, true), which passes. An explicit null, a map or a
      // list under a known key does not.
      function validAnswers(answers) {
        return answers is map
          && answers.keys().hasOnly(applicationAnswerKeys())
          && validAnswer(answers.get('fullName', true))
          && validAnswer(answers.get('whatsapp', true))
          && validAnswer(answers.get('zone', true))
          && validAnswer(answers.get('housingType', true))
          && validAnswer(answers.get('housingTenure', true))
          && validAnswer(answers.get('landlordAllows', true))
          && validAnswer(answers.get('outdoorSpace', true))
          && validAnswer(answers.get('adults', true))
          && validAnswer(answers.get('children', true))
          && validAnswer(answers.get('everyoneAgrees', true))
          && validAnswer(answers.get('otherPets', true))
          && validAnswer(answers.get('previousPets', true))
          && validAnswer(answers.get('hoursAlone', true))
          && validAnswer(answers.get('whyThisAnimal', true));
      }

      // adoptionApplications.enabled in src/config/shelter.ts. THIS is the
      // enforcing copy: while it returns false no applicant can create an
      // application by any route — not through the page, which 404s, and not
      // through the SDK called directly from a browser console. Reading,
      // withdrawing and the admin queue are unaffected. Switching the form on
      // means changing this line AND deploying the rules; a test fails if it
      // disagrees with the config.
      function applicationsEnabled() {
        return false;
      }

      // The id names the signed-in user as its applicant. A uid containing the
      // separator cannot pass, and cannot apply online. Nor could a pet id
      // containing `__`: create would accept it, but this split would then see
      // three parts and refuse the applicant's own get. Firestore-generated pet
      // ids are alphanumeric, so that only matters for a hand-authored id.
      function ownApplicationId() {
        return signedIn()
          && applicationId.split('__').size() == 2
          && applicationId.split('__')[1] == request.auth.uid;
      }

      // Only an animal on the wall takes applications. One document read, on
      // create only.
      function petAcceptsApplications(petId) {
        return exists(/databases/$(database)/documents/pets/$(petId))
          && get(/databases/$(database)/documents/pets/$(petId)).data.status == 'available';
      }

      // APPLICATION_STATUS_TRANSITIONS in src/lib/applications.ts. THIS is the
      // enforcing copy for admins; a test fails if the two drift.
      function applicationTransitions() {
        return {
          'submitted': ['reviewing', 'interview', 'rejected', 'withdrawn'],
          'reviewing': ['interview', 'approved', 'rejected', 'withdrawn'],
          'interview': ['reviewing', 'approved', 'rejected', 'withdrawn'],
          'approved': [],
          'rejected': ['reviewing'],
          'withdrawn': []
        };
      }

      // Approval and the adoption it creates are one batch, or neither happens.
      //
      // The first line reads the pet as it was BEFORE the batch (`get`, not
      // `getAfter`): an animal that already belongs to a family cannot be
      // approved for a second one. That is the one approval blocker enforced
      // here as well as in the UI, because it is the one that silently moves
      // who may read a microchip and a location — and two admins approving two
      // families for the same animal at once would otherwise both succeed.
      function approvalIsOneBatch() {
        return get(/databases/$(database)/documents/pets/$(resource.data.petId)).data.status
               != 'adopted'
          && existsAfter(/databases/$(database)/documents/adoptions/$(resource.data.petId))
          && getAfter(/databases/$(database)/documents/adoptions/$(resource.data.petId)).data.ownerUid
               == resource.data.applicantUid
          && getAfter(/databases/$(database)/documents/adoptions/$(resource.data.petId)).data.applicationId
               == applicationId
          && getAfter(/databases/$(database)/documents/pets/$(resource.data.petId)).data.status
               == 'adopted';
      }

      function applicantWithdraws() {
        return signedIn()
          && resource.data.applicantUid == request.auth.uid
          && resource.data.status in ['submitted', 'reviewing', 'interview']
          && request.resource.data.status == 'withdrawn'
          && request.resource.data.withdrawnAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'withdrawnAt', 'updatedAt']);
      }

      function adminMovesApplication() {
        return isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'updatedAt', 'decidedAt', 'decidedBy', 'withdrawnAt'])
          && request.resource.data.status in applicationTransitions()[resource.data.status]
          && request.resource.data.updatedAt == request.time
          && (request.resource.data.status in ['approved', 'rejected']
                ? (request.resource.data.decidedAt == request.time
                   && request.resource.data.decidedBy == request.auth.uid)
                : (request.resource.data.decidedAt == null
                   && request.resource.data.decidedBy == null))
          && (request.resource.data.status == 'withdrawn'
                ? request.resource.data.withdrawnAt == request.time
                : request.resource.data.withdrawnAt == null)
          && (request.resource.data.status != 'approved' || approvalIsOneBatch());
      }

      allow get: if isAdmin()
        || (ownApplicationId()
            && (resource == null || resource.data.applicantUid == request.auth.uid));

      allow list: if isAdmin()
        || (signedIn() && resource.data.applicantUid == request.auth.uid);

      allow create: if applicationsEnabled()
        && ownApplicationId()
        && request.resource.data.keys().hasOnly(applicationKeys())
        && request.resource.data.keys().hasAll(applicationKeys())
        && request.resource.data.applicantUid == request.auth.uid
        && request.resource.data.petId is string
        && applicationId == request.resource.data.petId + '__' + request.auth.uid
        && request.resource.data.applicantEmail == request.auth.token.email
        && request.resource.data.applicantEmailVerified == request.auth.token.email_verified
        && request.resource.data.status == 'submitted'
        && request.resource.data.submittedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.withdrawnAt == null
        && request.resource.data.decidedAt == null
        && request.resource.data.decidedBy == null
        && validAnswers(request.resource.data.answers)
        && petAcceptsApplications(request.resource.data.petId);

      allow update: if applicantWithdraws() || adminMovesApplication();

      allow delete: if false;

      // ── internal — the shelter's private notes on an applicant ───────────
      // A separate DOCUMENT, never a field on the application: rules protect
      // documents, not fields, and an applicant who could read the shelter's
      // private assessment of them is a problem the first time someone is
      // turned down. Admin-only in both directions, and no collection-group
      // rule reaches it. Split so the payload checks never run on a delete,
      // which is refused outright.
      match /internal/{docId} {
        allow read: if isAdmin();
        allow create, update: if isAdmin()
          && docId == 'notes'
          && request.resource.data.keys().hasOnly(['text', 'updatedAt', 'updatedBy'])
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 5000
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
    }

    // ── areas/{areaId} ─────────────────────────────────────────────────────
    // The shelter's own pens and yards. Admin-only in BOTH directions, which
    // is stricter than it first looks: an area list plus a placement ledger
    // is a map of the facility, and the layout of a building that houses
    // volunteers and animals is not public information. Nothing on the public
    // site needs it — the wall shows animals, never where they sleep.
    match /areas/{areaId} {
      allow read, write: if isAdmin();
    }

    // ── petDrafts/{draftId} ────────────────────────────────────────────────
    // Half-finished intake wizard state. Admin-only in both directions, and
    // deliberately OUTSIDE pets/ — a draft is not a pet. Keeping it in its own
    // top-level collection means an incomplete animal can never appear on the
    // public wall by accident, because getWall() reads `pets` and nothing
    // else. A `published: false` flag on a real pet document would put one
    // boolean between a half-typed record and the front page.
    //
    // ⚠️ A draft may carry a microchip number, which on a published pet lives
    // in the RESTRICTED tier (admin | owner). Admin-only here is strictly
    // narrower than that, so the tier is not weakened while a record is in
    // progress. It does mean a draft is not merely "unfinished data" — it is
    // restricted data, and the publish step is what moves each field into the
    // tier it belongs to.
    //
    // The draft id is minted client-side and becomes the petId on publish, so
    // photos uploaded to storage at pets/{petId}/… during the wizard already
    // sit at their final path. No move, no rewrite, no second URL.
    match /petDrafts/{draftId} {
      allow read, write: if isAdmin();
    }

    // ── qrTokens/{tokenId} ─────────────────────────────────────────────────
    // A collar tag's printed code → the animal it belongs to. Plan §2.5, §7.
    //
    // `get` is public and `list` is NOT, and that split is the reason this
    // block exists. A public `read` includes `list`, and `list` on this
    // collection is a directory of every tagged animal's code — the
    // enumeration a finder must never be able to perform. With `get` alone,
    // learning a token requires already holding it: 10 Crockford base32
    // characters are 50 bits, so guessing one is not a strategy.
    //
    // What `get` exposes is `petId`, `revokedAt`, `createdAt` and `createdBy`.
    // The public page does not use it — `/id/[token]` resolves through the
    // Admin SDK — so this lets a client do what the page already does and no
    // more. `createdBy` is an admin's uid, which `users/{uid}` does not let a
    // stranger resolve to anything.
    //
    // `list` is admin-only because the admin screens query by `petId` (one
    // animal's tags) and by `revokedAt == null` (the batch print sheet).
    //
    // ⚠️ Never copy a token onto `pets/{petId}`. That document is public READ,
    // which includes list, so a token field there would turn the adoption wall
    // into exactly the directory this block refuses to be.
    match /qrTokens/{tokenId} {
      allow get: if true;
      allow list: if isAdmin();

      // Minted only by an admin, only in the exact shape the app writes, only
      // for a pet that exists, and only unrevoked. The id alphabet is checked
      // HERE, not only in the client, because a token is PRINTED: an id a
      // finder could not type back from the tag is a tag that cannot work.
      // The pattern is mirrored in src/lib/qr-tokens.ts; a test fails if the
      // two copies drift.
      //
      // `hasAll` is REDUNDANT today, and measured to be: every key is also
      // dereferenced by a check below it, and reading a missing key errors,
      // which denies. A deliberate-break probe removed it and no test case
      // changed outcome. It stays so the required shape remains explicit if one
      // of those field checks is ever loosened.
      allow create: if isAdmin()
        && tokenId.matches('^[0-9A-HJKMNP-TV-Z]{10}$')
        && request.resource.data.keys().hasOnly(['petId', 'revokedAt', 'createdAt', 'createdBy'])
        && request.resource.data.keys().hasAll(['petId', 'revokedAt', 'createdAt', 'createdBy'])
        && request.resource.data.petId is string
        && request.resource.data.petId.size() > 0
        && exists(/databases/$(database)/documents/pets/$(request.resource.data.petId))
        && request.resource.data.revokedAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;

      // Revoking is the ONLY update, and it is one-way. The diff may touch
      // `revokedAt` and nothing else; the stored value must still be null, so
      // a revoked token can be neither un-revoked nor re-revoked with a later
      // date that would rewrite when it stopped working; and the new value
      // must be the server's clock, not the caller's.
      allow update: if isAdmin()
        && resource.data.revokedAt == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revokedAt'])
        && request.resource.data.revokedAt == request.time;

      // Never, not even for an admin. A printed tag outlives its record:
      // deleting the token would turn a revoked tag ("this tag is no longer
      // active — call us") into an unknown one, and an id freed by a delete
      // could be minted again for a DIFFERENT animal while the old tag is
      // still on a collar somewhere.
      allow delete: if false;
    }

    // ═══ FOOD — build-order step 13, plan §12 ═══════════════════════════════
    // Four collections, ADMIN-ONLY in both directions. A donation carries a
    // donor's name; the pantry and the daily sheet are operational data with
    // no reason to be readable by an adopter.
    //
    // What these rules add beyond isAdmin(), and why it is worth rules at all
    // when only admins can write: an admin account is still a phone in a
    // courtyard. The rules make the pantry's numbers impossible to REWRITE —
    // the ledger is append-only and a donation's lines are frozen — and they
    // make every write carry its own author and the server's clock. A wrong
    // number is then corrected in the open rather than edited away.
    //
    // What they deliberately do NOT check: that a ledger entry's `sourceId`
    // names a donation or batch that exists. That would be a get() per entry
    // on every write, and each entry is written in one atomic batch with its
    // source — by the client for a donation, by POST /api/food/cook-batch for a
    // cook batch.

    function isFoodCategory(category) {
      return category in ['meat', 'offal', 'bone', 'grain', 'vegetable', 'kibble', 'wet-food', 'other'];
    }

    // The account a write is attributed to must be the caller's own: its email
    // when the token carries one, otherwise its uid. Mirrors `user.email ??
    // user.uid` in the client.
    //
    // ⚠️ The value must be a NON-EMPTY STRING. The first version compared the
    // value with `token.get('email', null)`, so for a token with no email claim
    // a write carrying `recordedBy: null` matched null == null and was accepted
    // as attributed. Found by the independent evaluation on 2026-09-13 with the
    // Rules test API. The '' default cannot match a non-empty value.
    function isCaller(value) {
      return value is string && value.size() > 0
        && (value == request.auth.uid || value == request.auth.token.get('email', ''));
    }

    function optionalString(value, max) {
      return value == null || (value is string && value.size() <= max);
    }

    // Ten minutes of slack for a phone's clock. The client refuses anything
    // past five (CLOCK_SKEW_TOLERANCE_MS); this is the backstop, not the rule.
    function notInFuture(time) {
      return time is timestamp && time <= request.time + duration.value(10, 'm');
    }

    // The outcomes a cook batch records after the fact. Numbers are typed:
    // grams and dogs are whole, ladles may be half, fill is a fraction.
    function cookOutcomesValid(data) {
      return (data.potFillLevel == null
              || (data.potFillLevel is number && data.potFillLevel > 0 && data.potFillLevel <= 1))
        && (data.cookedWeightG == null
            || (data.cookedWeightG is int && data.cookedWeightG > 0 && data.cookedWeightG <= 2000000))
        && (data.ladlesYielded == null
            || (data.ladlesYielded is number && data.ladlesYielded > 0 && data.ladlesYielded <= 2000))
        && (data.dogsServed == null
            || (data.dogsServed is int && data.dogsServed > 0 && data.dogsServed <= 1000))
        && optionalString(data.cookedBy, 80)
        && optionalString(data.notes, 1000);
    }

    // ── foodDonations/{donationId} ─────────────────────────────────────────
    // Created once, after a person has reviewed every line — saving IS the
    // confirmation, so there is no unconfirmed donation for stock to leak
    // from. The lines cannot be validated item by item here (rules cannot loop
    // over a list); the NUMBERS that move stock live in the ledger below,
    // where each one is validated on its own.
    match /foodDonations/{donationId} {
      allow read: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['donor', 'receivedAt', 'rawText', 'lines',
             'source', 'extractedByModel', 'notes', 'recordedBy', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['donor', 'receivedAt', 'rawText', 'lines',
             'source', 'extractedByModel', 'notes', 'recordedBy', 'createdAt', 'updatedAt'])
        && optionalString(request.resource.data.donor, 120)
        && notInFuture(request.resource.data.receivedAt)
        && request.resource.data.rawText is string
        && request.resource.data.rawText.size() <= 2000
        && request.resource.data.lines is list
        && request.resource.data.lines.size() >= 1
        && request.resource.data.lines.size() <= 40
        && request.resource.data.source in ['manual', 'llm-parsed']
        && optionalString(request.resource.data.extractedByModel, 40)
        && (request.resource.data.source == 'llm-parsed' || request.resource.data.extractedByModel == null)
        && optionalString(request.resource.data.notes, 1000)
        && isCaller(request.resource.data.recordedBy)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Only the donor's name and the notes may change afterwards. The lines —
      // and so the stock they produced — are frozen: a donation recorded wrong
      // is answered by a correction in the ledger, where it is visible.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['donor', 'notes', 'updatedAt'])
        && optionalString(request.resource.data.donor, 120)
        && optionalString(request.resource.data.notes, 1000)
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ── foodStock/{category}/stockEntries/{entryId} — THE LEDGER ───────────
    // Stock is the sum of these, never a stored total. The category is in the
    // PATH so a category's stock is an unfiltered sum() over one subcollection:
    // measured 2026-09-12, the same sum filtered by a field on a flat
    // collection demanded a composite index, and this shape needs none.
    //
    // Append-only. The sign follows the kind — a donation only adds, a discard
    // only removes — and a correction must say why.
    //
    // ⚠️ A client may NOT write a `cook` entry. Those are written only by
    // POST /api/food/cook-batch, in the same atomic Admin SDK batch as the cook
    // batch they came from, after the server has run the toxic-ingredient gate.
    // See cookBatches below.
    match /foodStock/{category}/stockEntries/{entryId} {
      allow read: if isAdmin();

      allow create: if isAdmin()
        && isFoodCategory(category)
        && request.resource.data.keys().hasOnly(['kind', 'category', 'label', 'deltaG',
             'occurredAt', 'recordedAt', 'expiresAt', 'sourceId', 'note', 'recordedBy'])
        && request.resource.data.keys().hasAll(['kind', 'category', 'label', 'deltaG',
             'occurredAt', 'recordedAt', 'expiresAt', 'sourceId', 'note', 'recordedBy'])
        && request.resource.data.category == category
        && request.resource.data.kind in ['donation', 'discard', 'correction']
        && request.resource.data.deltaG is int
        && request.resource.data.deltaG != 0
        && math.abs(request.resource.data.deltaG) <= 2000000
        && (request.resource.data.kind != 'donation' || request.resource.data.deltaG > 0)
        && (request.resource.data.kind != 'discard' || request.resource.data.deltaG < 0)
        && request.resource.data.label is string
        && request.resource.data.label.size() > 0
        && request.resource.data.label.size() <= 80
        && notInFuture(request.resource.data.occurredAt)
        && request.resource.data.recordedAt == request.time
        && (request.resource.data.expiresAt == null || request.resource.data.expiresAt is timestamp)
        && (request.resource.data.kind in ['discard', 'correction']
            ? request.resource.data.sourceId == null
            : (request.resource.data.sourceId is string
               && request.resource.data.sourceId.size() > 0
               && request.resource.data.sourceId.size() <= 128))
        && optionalString(request.resource.data.note, 500)
        && (request.resource.data.kind != 'correction'
            || (request.resource.data.note is string && request.resource.data.note.size() > 0))
        && isCaller(request.resource.data.recordedBy);

      allow update, delete: if false;
    }

    // ── cookBatches/{batchId} ──────────────────────────────────────────────
    match /cookBatches/{batchId} {
      allow read: if isAdmin();

      // ⚠️ CLIENT CREATE IS DENIED for every caller, admins included. A cook
      // batch is created only by POST /api/food/cook-batch, which verifies the
      // ID token and the admin claim itself (checkRevoked) and runs the SAME
      // pure validateCookBatch the screen runs — the toxic-ingredient
      // acknowledgement included — before one Admin SDK batch writes the batch
      // and its `cook` ledger entries.
      //
      // Why the gate is not enforced HERE (decided 2026-09-13, after the
      // independent evaluation showed the previous create rule accepted an
      // unacknowledged toxic input):
      //   - toxicity is derived from the input's FREE-TEXT label by a word list
      //     that folds accents, needs letter-aware boundaries and honours "sin
      //     cebolla". Rules have no Unicode folding and ASCII regex boundaries,
      //     so a copy here would disagree with the screen;
      //   - inputs name a category, not a stock entry, so there is no stored
      //     hazard flag for a get() to read;
      //   - so a check here could only trust a toxic flag the client copied in,
      //     which catches a UI bug but not a falsified flag. The server-side
      //     validator catches both.
      // Tested: cook-batch-handler.test.ts (both branches) and
      // scripts/probe-food-rules.mjs (this denial).
      allow create: if false;

      // The outcomes arrive hours later — the pot is weighed after cooking and
      // the ladles counted after serving. The INPUTS never change: each one is
      // also a ledger entry that has already moved the stock.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['potFillLevel', 'cookedWeightG', 'ladlesYielded', 'dogsServed',
                       'cookedBy', 'notes', 'updatedAt'])
        && cookOutcomesValid(request.resource.data)
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ── feedingLog/{YYYY-MM-DD} ────────────────────────────────────────────
    // One document per day, edited through the day. Servings move no stock
    // (cook batches do), so a day written by mistake may be deleted outright.
    match /feedingLog/{date} {
      allow read: if isAdmin();

      allow create, update: if isAdmin()
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['date', 'batchIds', 'servings', 'dogsPresent',
             'shortfallNote', 'updatedBy', 'updatedAt'])
        && request.resource.data.keys().hasAll(['date', 'batchIds', 'servings', 'dogsPresent',
             'shortfallNote', 'updatedBy', 'updatedAt'])
        && request.resource.data.date == date
        && request.resource.data.batchIds is list
        && request.resource.data.batchIds.size() <= 10
        && request.resource.data.servings is list
        && request.resource.data.servings.size() <= 200
        && (request.resource.data.dogsPresent == null
            || (request.resource.data.dogsPresent is int
                && request.resource.data.dogsPresent >= 0
                && request.resource.data.dogsPresent <= 1000))
        && optionalString(request.resource.data.shortfallNote, 500)
        && isCaller(request.resource.data.updatedBy)
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }

    // ── default deny ───────────────────────────────────────────────────────
    // Anything not matched above is inaccessible. New collections must opt in
    // deliberately rather than inherit access by accident.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
