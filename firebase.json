{
  "hosting": {
    "//": "Firebase Hosting fronts the Cloud Run service: CDN caching and a custom domain for free, SSR compute on Cloud Run. serviceId and region must match the Cloud Run service Terraform creates (terraform/modules/cloud_run).",
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "pet-shelter-web",
          "region": "us-central1"
        }
      }
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|png|webp|avif|svg|woff2)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
      },
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "X-Frame-Options", "value": "DENY" },
          {
            "//": "Deny by default; Maps and geolocation are opened deliberately where needed.",
            "key": "Permissions-Policy",
            "value": "geolocation=(self), camera=(), microphone=(), payment=(), usb=()"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
