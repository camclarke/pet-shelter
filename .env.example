# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in from the Firebase console:
#   Project settings → General → Your apps → SDK setup and configuration
#
# Every NEXT_PUBLIC_ value below is shipped to the browser and is NOT a
# secret. The Firebase web config is public by design; firestore.rules is
# what protects the data. Do not add real secrets to this file — those
# belong in Secret Manager, read by the Cloud Run service at runtime.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Maps JavaScript API key.
# Restrict it by HTTP referrer to wawitas.org and localhost before going live —
# an unrestricted Maps key is the fastest way to run up a bill on this project.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# reCAPTCHA Enterprise site key for App Check. Required in production: it is
# what stops the public sighting endpoint from accepting writes off-origin.
NEXT_PUBLIC_APP_CHECK_SITE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Server-only. Never prefixed with NEXT_PUBLIC_, never sent to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# The GCP project the Admin SDK talks to. Local development runs against REAL
# Firestore, so this must be set — and set BEFORE you run
# `gcloud auth application-default login`.
#
# Left unset, the Admin SDK resolves Application Default Credentials and
# connects to whatever project your gcloud is currently pointed at. That
# failure is silent: there is no error, the writes simply land somewhere else.
# Use a project dedicated to the shelter.
GOOGLE_CLOUD_PROJECT=
GCLOUD_PROJECT=

# Admin SDK credentials for LOCAL development only. On Cloud Run this is left
# unset and the Admin SDK authenticates via the runtime service account's
# Application Default Credentials instead — nothing to leak, nothing to
# rotate. Locally, prefer `gcloud auth application-default login` over pasting
# a key here; if you must, paste the full JSON key contents as a single line.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ─────────────────────────────────────────────────────────────────────────────
# Gemini, for photo-assisted intake. AI Studio, NEVER Vertex.
# See docs/gemini-api-playbook.md.
# ─────────────────────────────────────────────────────────────────────────────

# A REAL secret, unlike every NEXT_PUBLIC_FIREBASE_* value above, which are
# public by design. Get one from https://aistudio.google.com/apikey.
#
# NEVER add a NEXT_PUBLIC_ alias for this. That prefix means "compile into the
# browser bundle and serve it to everyone". src/lib/ai/google.ts imports
# `server-only` so a client component touching it fails the BUILD rather than
# shipping the key — do not remove that import.
#
# Left unset, photo suggestions degrade politely: /api/intake/suggest answers
# 503 and the intake wizard shows the manual form. Admitting an animal never
# depends on this key.
#
# On Cloud Run this is a RUNTIME env var, not a build arg (contrast the
# NEXT_PUBLIC_* values, which next build inlines). Terraform owns the Cloud Run
# env list, so it belongs in Secret Manager and in terraform/, NOT in a
# --set-env-vars flag in deploy.yml — a CI-injected var Terraform does not
# declare gets planned for deletion on every apply.
GEMINI_API_KEY=

# Some AI SDK code paths read this name instead. Set it to the same value.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional model overrides. The defaults live in src/lib/ai/model-ids.ts and
# are UNVERIFIED against a live API from this project. Model ids churn every
# few months; these exist so a churned id is a config change, not a deploy.
# GEMINI_FLASH_MODEL=
# GEMINI_FLASH_LITE_MODEL=
# GEMINI_PRO_MODEL=
