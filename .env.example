# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in from the Firebase console:
#   Project settings → General → Your apps → SDK setup and configuration
#
# Every PUBLIC_ value below is shipped to the browser and is NOT a secret. The
# Firebase web config is public by design; firestore.rules is what protects the
# data. Do not treat these as credentials, and do not add real secrets here —
# those belong in Secret Manager, read by Cloud Functions at runtime.
# ─────────────────────────────────────────────────────────────────────────────

PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# Maps JavaScript API key.
# Restrict it by HTTP referrer to wawitas.org and localhost before going live —
# an unrestricted Maps key is the fastest way to run up a bill on this project.
PUBLIC_GOOGLE_MAPS_API_KEY=

# reCAPTCHA Enterprise site key for App Check. Required in production: it is
# what stops the public sighting endpoint from accepting writes off-origin.
PUBLIC_APP_CHECK_SITE_KEY=

# Point the client at local emulators instead of live GCP.
PUBLIC_USE_EMULATORS=true
