# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in from the Firebase console:
#   Project settings → General → Your apps → SDK setup and configuration
#
# Every NEXT_PUBLIC_ value below is shipped to the browser and is NOT a
# secret. The Firebase web config is public by design; firestore.rules is
# what protects the data. Do not add real secrets to this file — those
# belong in Secret Manager, read by the Cloud Run service at runtime.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Maps JavaScript API key.
# Restrict it by HTTP referrer to wawitas.org and localhost before going live —
# an unrestricted Maps key is the fastest way to run up a bill on this project.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# reCAPTCHA Enterprise site key for App Check. Required in production: it is
# what stops the public sighting endpoint from accepting writes off-origin.
NEXT_PUBLIC_APP_CHECK_SITE_KEY=

# Point the client SDK at local emulators instead of live GCP.
NEXT_PUBLIC_USE_EMULATORS=true

# ─────────────────────────────────────────────────────────────────────────────
# Server-only. Never prefixed with NEXT_PUBLIC_, never sent to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Admin SDK credentials for LOCAL development only. On Cloud Run this is left
# unset and the Admin SDK authenticates via the runtime service account's
# Application Default Credentials instead — nothing to leak, nothing to
# rotate. Paste the full JSON key contents as a single line, or better:
# point FIRESTORE_EMULATOR_HOST at the emulator suite and skip this entirely.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Set by `firebase emulators:start`; the Admin and Web SDKs both honour it
# automatically when present.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
