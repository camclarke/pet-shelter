# Copy to terraform.tfvars (gitignored) and fill in for the current
# environment. This is the file that changes wholesale when the project moves
# to a new GCP tenant — everything else in terraform/ stays as-is.

project_id      = "wawitas-org"
region          = "us-central1"
billing_account = "XXXXXX-XXXXXX-XXXXXX"

budget_amount_usd  = 5
budget_alert_email = "israel.rocha.rocha@live.com"

app_name    = "pet-shelter-web"
environment = "production"

# The ONLY repository allowed to deploy via Workload Identity Federation. This
# is a security boundary — see variables.tf. A fork that changes this without
# also creating its own pool is handing deploy rights to the original repo.
github_repository = "camclarke/pet-shelter"

# BOOTSTRAP ONLY. Cloud Run cannot be created without an image, so this must
# name a tag that already exists at the first apply — Terraform does not build
# images, and `plan` never checks that the reference resolves.
#
# After that, CI owns the running image and this value goes stale by design.
# `cloud_run.tf` has `lifecycle { ignore_changes }` on it, so a later apply
# will NOT roll production back to whatever is written here. Do not "fix" this
# to match production; the drift is the intended state.
container_image = "us-central1-docker.pkg.dev/wawitas-org/pet-shelter-web/app:bootstrap"
